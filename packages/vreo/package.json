{
  "name": "@realsee/vreo",
  "version": "3.0.0-webgpu.9",
  "type": "module",
  "description": "Vreo (VR Video 缩写) 是基于如视三维渲染引擎 Five 和 用户界面构建库 React 实现的如视 3D 空间剧本播放器。",
  "keywords": [
    "realsee",
    "vreo"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./Player": {
      "types": "./lib/Player/index.d.ts",
      "import": "./lib/Player/index.js"
    },
    "./PlayController": {
      "types": "./lib/PlayController/index.d.ts",
      "import": "./lib/PlayController/index.js"
    },
    "./react": {
      "types": "./lib/react/index.d.ts",
      "import": "./lib/react/index.js"
    },
    "./plugins/CameraMovementPlugin": {
      "types": "./lib/fivePlugins/CameraMovementPlugin/index.d.ts",
      "import": "./lib/plugins/CameraMovementPlugin.js"
    },
    "./plugins/CSS3DRenderPlugin": {
      "types": "./lib/fivePlugins/CSS3DRenderPlugin/index.d.ts",
      "import": "./lib/plugins/CSS3DRenderPlugin.js"
    },
    "./plugins/ModelTVVideoPlugin": {
      "types": "./lib/fivePlugins/ModelTVVideoPlugin/index.d.ts",
      "import": "./lib/plugins/ModelTVVideoPlugin.js"
    },
    "./types": {
      "types": "./lib/typings/index.d.ts",
      "import": "./lib/types/index.js"
    },
    "./styles/default.css": "./stylesheets/default.css",
    "./styles/SpatialScenePanel.css": "./stylesheets/custom/SpatialScenePanel.css",
    "./package.json": "./package.json"
  },
  "author": "BEIKE REALSEE TECHNOLOGY (HK) LIMITED",
  "license": "MIT",
  "private": false,
  "files": [
    "lib",
    "stylesheets",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "dev": "vite --port=3088 --host 0.0.0.0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "build": "rm -rf lib && vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "docs": "typedoc"
  },
  "peerDependencies": {
    "@realsee/dnalogel": "^4.0.0-webgpu.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.183.2",
    "mobx": "^7.0.0",
    "mobx-react-lite": "^5.0.0",
    "@realsee/five-webgpu": "^1.0.0-alpha.7"
  },
  "devDependencies": {
    "@realsee/dnalogel": "4.0.0-webgpu.4",
    "three": "0.183.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "mobx": "7.0.3",
    "mobx-react-lite": "5.0.3",
    "@types/node": "22.20.0",
    "@types/offscreencanvas": "2019.7.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/react-transition-group": "4.4.5",
    "@vitejs/plugin-react": "6.1.1",
    "typedoc": "0.28.20",
    "typescript": "5.8.3",
    "vite": "8.3.0",
    "@realsee/five-webgpu": "1.0.0-alpha.7",
    "@types/three": "0.183.1"
  },
  "dependencies": {
    "classnames": "2.3.2",
    "@tweenjs/tween.js": "18.6.4"
  },
  "sideEffects": [
    "./stylesheets/**/*.css"
  ]
}
