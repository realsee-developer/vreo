{
  "extends": "./tsconfig.json",
  "include": [
    "resources/**/*.ts",
    "resources/**/*.tsx"
  ],
  "exclude": [
    "test"
  ],
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "resources",
    "outDir": "lib",
    "moduleResolution": "Bundler"
  }
}
